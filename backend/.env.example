# =========================================================
# SETU Backend Environment Configuration
# =========================================================

# Optional live train status provider
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Optional Gemini explanation assistant. Never put this key in frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated browser origins allowed to call the API in addition to local development
CORS_ALLOWED_ORIGINS=

# Destination recipient for all passenger feedback submissions
FEEDBACK_EMAIL=npb.sahej@gmail.com

# Active email provider: resend | brevo | sendgrid | smtp
EMAIL_PROVIDER=resend

# Transactional Email API Key (e.g. Resend re_... or Brevo xkeysib-... or SendGrid SG...)
EMAIL_API_KEY=

# Sender address (Resend testing uses onboarding@resend.dev)
EMAIL_FROM=SETU Feedback <onboarding@resend.dev>

# RapidAPI Key for IRCTC Telemetry (irctc1.p.rapidapi.com)
# Obtain your key from: https://rapidapi.com/IRCTCAPI/api/irctc1
RAPIDAPI_KEY=your_rapidapi_key_here

# RailRadar Primary Railway API Key (api.railradar.in)
RAILRADAR_API_KEY=your_railradar_api_key_here
