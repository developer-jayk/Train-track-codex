# =========================================================
# SETU Backend Environment Configuration
# =========================================================

# Destination recipient for all passenger feedback submissions
FEEDBACK_EMAIL=npb.sahej@gmail.com

# Active email provider: resend | brevo | sendgrid | smtp
EMAIL_PROVIDER=resend

# Transactional Email API Key (e.g. Resend re_... or Brevo xkeysib-... or SendGrid SG...)
EMAIL_API_KEY=

# Sender address (Resend testing uses onboarding@resend.dev)
EMAIL_FROM=SETU Feedback <onboarding@resend.dev>

# Optional SMTP Relay (e.g., Gmail SMTP with App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=npb.sahej@gmail.com
# SMTP_PASSWORD=
